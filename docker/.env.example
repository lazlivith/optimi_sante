# Copiez ce fichier en ".env" (même dossier) et renseignez vos vraies valeurs.
# Le fichier ".env" n'est jamais poussé sur Git (voir .gitignore) — vos identifiants
# restent uniquement sur votre machine, docker-compose le lit automatiquement.
# Après modification : docker compose -f docker/docker-compose.yml up -d --no-deps backend

# --- Mailtrap (sandbox.smtp.mailtrap.io) ---
# Créez un compte gratuit sur https://mailtrap.io, ouvrez votre "Inbox" de test,
# onglet "SMTP Settings" -> "Show credentials" -> copiez Username et Password.
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Stripe (mode Test) ---
# Créez un compte sur https://dashboard.stripe.com (gratuit), restez en mode "Test".
# Dashboard -> Developers -> API keys -> "Secret key" (commence par sk_test_...)
STRIPE_SECRET_KEY=

# Dashboard -> Developers -> Webhooks -> Add endpoint, OU en local avec la Stripe CLI :
#   stripe listen --forward-to localhost:8080/api/v1/payments/webhook
# La CLI affiche alors un secret qui commence par whsec_... -> à copier ici.
STRIPE_WEBHOOK_SECRET=

# --- Cloudinary (stockage documents/médias) ---
# Dashboard -> https://console.cloudinary.com/ -> Account Details.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Mailtrap : envoi reel (production) ---
# Sandbox (defaut) = les emails sont CAPTURES dans une boite de test, jamais livres.
# Pour livrer a de vraies adresses : Mailtrap -> Sending Domains -> ajouter et verifier
# votre domaine (enregistrements DNS SPF/DKIM), puis basculer ces variables :
#   MAIL_HOST=live.smtp.mailtrap.io
#   MAIL_PORT=587
#   MAIL_USERNAME=api
#   MAIL_PASSWORD=<votre token SMTP Mailtrap Sending>
#   MAIL_FROM=no-reply@votre-domaine-verifie
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_FROM=no-reply@optimisante.fr

# --- Mailtrap API (facultatif) : statistiques de delivrabilite cote admin ---
# Mailtrap -> Settings -> API Tokens. L'ID de compte se lit dans l'URL du dashboard.
MAILTRAP_API_TOKEN=
MAILTRAP_ACCOUNT_ID=
