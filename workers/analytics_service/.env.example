# Copier en .env pour un lancement local hors docker-compose.
# En docker-compose ces valeurs sont fournies par le service "analytics".

DATABASE_URL=postgresql+psycopg2://postgres:Investx2026@localhost:5051/optimisante_db
EXPORT_DIR=./_exports
SCHEDULER_ENABLED=true
SCHEDULE_CRON_HOUR=2
SCHEDULE_CRON_MINUTE=0
DEFAULT_WINDOW_DAYS=90
