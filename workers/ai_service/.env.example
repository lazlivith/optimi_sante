# Copiez ce fichier en ".env" pour un lancement hors Docker.
# En Docker, ces variables sont fournies par docker/docker-compose.yml (qui lit docker/.env).

# --- Gemini : extraction documentaire (vision + PDF natif) ---
# Clé gratuite : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Mistral : chat, rédaction, résumés (hébergement UE) ---
# Clé : https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# --- Modèles (format LiteLLM "<provider>/<model>") ---
# Changer de fournisseur = changer ces lignes, rien d'autre dans le code.
EXTRACTION_MODEL=gemini/gemini-3.6-flash
CHAT_MODEL=mistral/mistral-small-latest
DRAFT_MODEL=mistral/mistral-small-latest
EMBEDDING_MODEL=mistral/mistral-embed

# --- Backend Java (outils du chat : catalogue, commandes, dossiers) ---
BACKEND_BASE_URL=http://backend:8080

# --- Base de données (contexte catalogue) ---
DATABASE_URL=postgresql+psycopg2://postgres:Investx2026@postgres:5432/optimisante_db

# --- Garde-fous ---
MAX_UPLOAD_MB=15
REQUEST_TIMEOUT_SECONDS=120
CHAT_MAX_HISTORY=20
